<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sayt bilan aloqa -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS jo'natish (ilovaning asosiy vazifasi) -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Natija haqida bildirishnoma (Android 13+ da so'raladi) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Telefon yoqilganda tekshiruvni tiklash -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ikki SIM bo'lsa, qaysi biridan yuborishni tanlash uchun -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Batareya tejash rejimidan chiqarishni so'rash -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <application
        android:name=".KursSmsApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KursSms">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Telefon qayta yoqilganda yoki ilova yangilanganda tekshiruvni tiklaydi -->
        <receiver
            android:name=".ish.YoqishReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
