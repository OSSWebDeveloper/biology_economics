<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sayt bilan aloqa -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- SMS jo'natish (ilovaning asosiy vazifasi) -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Natija haqida bildirishnoma (Android 13+ da so'raladi) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Jo'natish sessiyasi: foydalanuvchi "Ulanish" ni bosganda qisqa
         muddatli xizmat ishga tushadi (eng ko'pi 15 daqiqa). Ilova fonda
         doimiy aylanib turmaydi. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Ikki SIM bo'lsa, qaysi biridan yuborishni tanlash uchun -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Batareya tejash rejimidan chiqarishni so'rash -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <application
        android:name=".KursSmsApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KursSms">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bitta jo'natish sessiyasi. Foydalanuvchi ilovada "Ulanish" ni
             bosganda boshlanadi, ishini bajarib bo'lgach yoki 15 daqiqada
             ish kelmasa - o'zi to'xtaydi. -->
        <service
            android:name=".ish.SessiyaXizmati"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
